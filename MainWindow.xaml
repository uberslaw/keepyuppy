<Window x:Class="KeepyUppy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeepyUppy"
        Title="KeepyUppy"
        Width="430"
        Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{StaticResource InkBrush}">
  <Window.Resources>
    <Style x:Key="StepButton" TargetType="RepeatButton">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="#1E5F8A"/>
      <Setter Property="Background" Value="#66FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1.2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Delay" Value="380"/>
      <Setter Property="Interval" Value="70"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="13">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TimeBox" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="Foreground" Value="#1E5F8A"/>
      <Setter Property="Background" Value="#5CFFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1.2"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="72"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="MaxLength" Value="2"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CaretBrush" Value="#1E5F8A"/>
      <Setter Property="SelectionBrush" Value="#4EB4E0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14">
              <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TimerSwitchStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="Track" CornerRadius="16" BorderThickness="1.2" BorderBrush="{StaticResource GlassStrokeBrush}" Background="#4DFFFFFF"/>
              <Border x:Name="Thumb" Width="26" Height="26" CornerRadius="13" Background="#F5FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0" BorderBrush="#E6FFFFFF" BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25" Color="#1E5F8A"/>
                </Border.Effect>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#B34EB4E0"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell" Margin="16" CornerRadius="28" MouseLeftButtonDown="Shell_MouseLeftButtonDown">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE08A" Offset="0"/>
        <GradientStop Color="#FFF6E4" Offset="0.46"/>
        <GradientStop Color="#D7F2FB" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.28" Color="#1E5F8A"/>
    </Border.Effect>
    <Grid x:Name="ShellContent" SizeChanged="ShellContent_SizeChanged">
      <Ellipse Width="72" Height="24" Fill="White" Opacity="0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,146,0,0" IsHitTestVisible="False"/>
      <Ellipse Width="88" Height="26" Fill="White" Opacity="0.34" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="164,246,0,0" IsHitTestVisible="False"/>
      <Ellipse Width="64" Height="18" Fill="White" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,96" IsHitTestVisible="False"/>

      <local:BalloonControl BalloonColor="#EF6F57" Width="66" Height="87"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-48,-44,0,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="-24"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl BalloonColor="#F5A142" Width="44" Height="58"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-12,112,0,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="-17"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl BalloonColor="#4EB4E0" Width="44" Height="58"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="146,108,0,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="4"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl BalloonColor="#A98BE0" Width="40" Height="53"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="250,108,0,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="18"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl BalloonColor="#7DCA6A" Width="36" Height="48"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="296,68,0,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="-20"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl BalloonColor="#F6D365" Width="52" Height="69"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="198,172,0,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="-8"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl BalloonColor="#F4A6C8" Width="48" Height="63"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,368,0,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="27"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl BalloonColor="#EF6F57" Width="46" Height="61"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="112,0,0,29"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="-26"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl BalloonColor="#4EB4E0" Width="56" Height="74"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="356,524,0,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="12"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl BalloonColor="#F4A6C8" Width="62" Height="82"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="244,-28,0,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="14"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl BalloonColor="#A98BE0" Width="80" Height="106"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="78,308,0,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="-13"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl BalloonColor="#F5A142" Width="72" Height="95"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="236,286,0,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="11"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl BalloonColor="#EF6F57" Width="92" Height="121"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,332,-40,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="22"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl x:Name="BlueBalloon" BalloonColor="#4EB4E0" Width="118" Height="156"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-50,198,0,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <TransformGroup>
            <RotateTransform Angle="-18"/>
            <TranslateTransform/>
          </TransformGroup>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl x:Name="OrangeBalloon" BalloonColor="#F5A142" Width="130" Height="172"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,96,-44,0"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <TransformGroup>
            <RotateTransform Angle="16"/>
            <TranslateTransform/>
          </TransformGroup>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl x:Name="GreenBalloon" BalloonColor="#7DCA6A" Width="108" Height="142"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-22,0,0,-26"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <TransformGroup>
            <RotateTransform Angle="7"/>
            <TranslateTransform/>
          </TransformGroup>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>
      <local:BalloonControl BalloonColor="#F6D365" Width="116" Height="153"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="186,0,0,-23"
                            RenderTransformOrigin="0.5,0.28">
        <local:BalloonControl.RenderTransform>
          <RotateTransform Angle="8"/>
        </local:BalloonControl.RenderTransform>
      </local:BalloonControl>

      <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="2,0,0,8">
          <StackPanel VerticalAlignment="Center" Margin="10,8,46,0">
            <TextBlock Text="KeepyUppy"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="34"
                       Foreground="#1E5F8A"/>
            <TextBlock Text="keeps the screen from locking"
                       FontSize="14"
                       Foreground="#3E6F90"
                       Margin="2,-1,0,0"/>
          </StackPanel>
          <Button Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Click="CloseButton_Click" Cursor="Hand" ToolTip="Hide to the tray"
                  AutomationProperties.Name="Hide to the tray">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="CloseBd" CornerRadius="18" BorderThickness="1.2" BorderBrush="{StaticResource GlassStrokeBrush}">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#B3FFFFFF" Offset="0"/>
                      <GradientStop Color="#47FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.18" Color="#1E5F8A"/>
                  </Border.Effect>
                  <Path Data="M9,9 L17,17 M17,9 L9,17" Stroke="#1E5F8A" StrokeThickness="2.1"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="26" Height="26"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="CloseBd" Property="Opacity" Value="0.82"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="6,10,6,0" VerticalAlignment="Top">
            <Border x:Name="StatusPill" HorizontalAlignment="Center" CornerRadius="16" BorderThickness="1.2"
                    BorderBrush="{StaticResource GlassStrokeBrush}" Padding="18,5" Margin="0,0,0,14"
                    Background="{StaticResource GlassNeutralBrush}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.16" Color="#1E5F8A"/>
              </Border.Effect>
              <Grid>
                <Border Height="12" VerticalAlignment="Top" Margin="8,0,8,0" CornerRadius="6" Background="{StaticResource GlassShineBrush}" IsHitTestVisible="False"/>
                <TextBlock x:Name="StatusText" Text="Off" FontFamily="{StaticResource DisplayFont}" FontSize="16" Foreground="#1E5F8A" HorizontalAlignment="Center"/>
              </Grid>
            </Border>

            <Button x:Name="PowerButton" Height="64" Margin="4,0,4,16" Click="PowerButton_Click" Cursor="Hand"
                    FontFamily="{StaticResource DisplayFont}" FontSize="26" Foreground="#1E5F8A"
                    Background="{StaticResource GlassBlueBrush}" Content="Turn on" AutomationProperties.Name="Turn keep awake on or off">
              <Button.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" Color="#1E5F8A"/>
              </Button.Effect>
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="PowerBd" Background="{TemplateBinding Background}" CornerRadius="32"
                          BorderThickness="1.25" BorderBrush="{StaticResource GlassStrokeBrush}" RenderTransformOrigin="0.5,0.5">
                    <Grid>
                      <Border Height="22" VerticalAlignment="Top" Margin="22,4,22,0" CornerRadius="11"
                              Background="{StaticResource GlassShineBrush}" IsHitTestVisible="False"/>
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="PowerBd" Property="Opacity" Value="0.92"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="PowerBd" Property="RenderTransform">
                        <Setter.Value>
                          <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>

            <Border CornerRadius="22" BorderThickness="1.25" BorderBrush="{StaticResource GlassStrokeBrush}"
                    Background="{StaticResource GlassNeutralBrush}" Padding="16,14">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#1E5F8A"/>
              </Border.Effect>
              <StackPanel>
                <Grid>
                  <TextBlock Text="Turn off after" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                             Foreground="#1E5F8A" VerticalAlignment="Center"/>
                  <ToggleButton x:Name="TimerSwitch" Style="{StaticResource TimerSwitchStyle}"
                                HorizontalAlignment="Right" Click="TimerSwitch_Click"
                                AutomationProperties.Name="Enable turn off after"/>
                </Grid>

                <StackPanel x:Name="TimePanel" Margin="0,12,0,0" Visibility="Collapsed">
                  <Grid x:Name="SpinnerGrid">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="HH : MM : SS" FontSize="11" HorizontalAlignment="Center" Foreground="#5E7E96" Margin="0,0,0,6"/>
                    <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <StackPanel>
                <RepeatButton Content="+" Style="{StaticResource StepButton}" HorizontalAlignment="Center" Margin="0,0,0,4"
                              Click="StepUp_Click" Tag="h" AutomationProperties.Name="Increase hours"/>
                <TextBox x:Name="HourBox" Style="{StaticResource TimeBox}" Tag="h"
                         PreviewTextInput="TimeBox_PreviewTextInput"
                         PreviewKeyDown="TimeBox_PreviewKeyDown"
                         LostFocus="TimeBox_LostFocus"
                         GotKeyboardFocus="TimeBox_GotFocus"
                         AutomationProperties.Name="Hours"/>
                <TextBlock Text="hrs" HorizontalAlignment="Center" FontSize="11" Foreground="#6A8BA0" Margin="0,3,0,3"/>
                <RepeatButton Content="-" Style="{StaticResource StepButton}" HorizontalAlignment="Center"
                              Click="StepDown_Click" Tag="h" AutomationProperties.Name="Decrease hours"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text=":" FontFamily="{StaticResource DisplayFont}" FontSize="26"
                         Foreground="#1E5F8A" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,18"/>
              <StackPanel Grid.Column="2">
                <RepeatButton Content="+" Style="{StaticResource StepButton}" HorizontalAlignment="Center" Margin="0,0,0,4"
                              Click="StepUp_Click" Tag="m" AutomationProperties.Name="Increase minutes"/>
                <TextBox x:Name="MinuteBox" Style="{StaticResource TimeBox}" Tag="m"
                         PreviewTextInput="TimeBox_PreviewTextInput"
                         PreviewKeyDown="TimeBox_PreviewKeyDown"
                         LostFocus="TimeBox_LostFocus"
                         GotKeyboardFocus="TimeBox_GotFocus"
                         AutomationProperties.Name="Minutes"/>
                <TextBlock Text="min" HorizontalAlignment="Center" FontSize="11" Foreground="#6A8BA0" Margin="0,3,0,3"/>
                <RepeatButton Content="-" Style="{StaticResource StepButton}" HorizontalAlignment="Center"
                              Click="StepDown_Click" Tag="m" AutomationProperties.Name="Decrease minutes"/>
              </StackPanel>
              <TextBlock Grid.Column="3" Text=":" FontFamily="{StaticResource DisplayFont}" FontSize="26"
                         Foreground="#1E5F8A" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,18"/>
              <StackPanel Grid.Column="4">
                <RepeatButton Content="+" Style="{StaticResource StepButton}" HorizontalAlignment="Center" Margin="0,0,0,4"
                              Click="StepUp_Click" Tag="s" AutomationProperties.Name="Increase seconds"/>
                <TextBox x:Name="SecondBox" Style="{StaticResource TimeBox}" Tag="s"
                         PreviewTextInput="TimeBox_PreviewTextInput"
                         PreviewKeyDown="TimeBox_PreviewKeyDown"
                         LostFocus="TimeBox_LostFocus"
                         GotKeyboardFocus="TimeBox_GotFocus"
                         AutomationProperties.Name="Seconds"/>
                <TextBlock Text="sec" HorizontalAlignment="Center" FontSize="11" Foreground="#6A8BA0" Margin="0,3,0,3"/>
                <RepeatButton Content="-" Style="{StaticResource StepButton}" HorizontalAlignment="Center"
                              Click="StepDown_Click" Tag="s" AutomationProperties.Name="Decrease seconds"/>
              </StackPanel>
                    </Grid>
                  </Grid>
                  <TextBlock x:Name="CountdownCaption" Text="Turns off in" HorizontalAlignment="Center"
                             FontSize="12" Foreground="#5E7E96" Margin="0,4,0,0" Visibility="Collapsed"/>
                  <TextBlock x:Name="CountdownText" Text="00:30:00" HorizontalAlignment="Center" TextAlignment="Center"
                             FontFamily="{StaticResource DisplayFont}" FontSize="32" Foreground="#E0862A" MinHeight="40" Visibility="Collapsed"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" TextAlignment="Center" Foreground="#EF6F57"
                       FontSize="12" Margin="8,8,8,0" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
