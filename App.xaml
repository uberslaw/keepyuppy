<Application x:Class="KeepyUppy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <FontFamily x:Key="DisplayFont">Arial Rounded MT Bold, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="BlueyBrush" Color="#4EB4E0"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1E5F8A"/>
    <SolidColorBrush x:Key="SoftInkBrush" Color="#3E6F90"/>
    <SolidColorBrush x:Key="ChilliBrush" Color="#EF6F57"/>
    <SolidColorBrush x:Key="BingoBrush" Color="#E0862A"/>
    <SolidColorBrush x:Key="CoralInkBrush" Color="#9C3A2E"/>
    <LinearGradientBrush x:Key="GlassNeutralBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#A6FFFFFF" Offset="0"/>
      <GradientStop Color="#47FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBlueBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#D9FFFFFF" Offset="0"/>
      <GradientStop Color="#8A4EB4E0" Offset="0.42"/>
      <GradientStop Color="#B34EB4E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCoralBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#D9FFFFFF" Offset="0"/>
      <GradientStop Color="#8AEF6F57" Offset="0.42"/>
      <GradientStop Color="#B3EF6F57" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassShineBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#B3FFFFFF" Offset="0"/>
      <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#E6FFFFFF"/>
  </Application.Resources>
</Application>
